{
	# HTTPS_SITES use a certificate of Caddy's own local CA (no public certificate needed):
	# no HTTP -> HTTPS redirect, so the plain-HTTP console on APP_LISTEN keeps working,
	# and no attempt to install the local CA in the container's trust store.
	auto_https disable_redirects
	skip_install_trust
	# Browsers send no server name (SNI) when connecting to an IP address: use this certificate.
	default_sni {$HTTPS_DEFAULT_SNI:localhost}
}

(console) {
	# everything compressed except the live updates (/api/events): each event must leave at once
	@compress not path /api/events
	encode @compress zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), geolocation=(self)"
		-Server
	}
	reverse_proxy app:8787
	# access log for CrowdSec (JSON): 3 files of 10 MB, 7 days. Authorization and Cookie are never
	# written by Caddy; the app's own secret headers are removed here.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>headers>X-Cda-Bridge-Token delete
				request>headers>X-Backup-Password delete
			}
		}
	}
}

# Main address: ":80" (plain HTTP) or a public hostname (automatic Let's Encrypt certificate).
{$APP_LISTEN::80} {
	import console
}

# HTTPS only (HTTP_REDIRECT_LISTEN="http://", HTTP_REDIRECT="https://app.example.it"): nothing is
# served in clear, plain HTTP on any address answers with a permanent redirect to the HTTPS address.
# The certificates of a public hostname (APP_LISTEN) still renew by themselves: the ACME challenge
# on port 80 is answered before this. Unset, it only matches a name that never exists.
{$HTTP_REDIRECT_LISTEN:http://redirect.invalid} {
	redir {$HTTP_REDIRECT:https://localhost}{uri} permanent
}

# Self-signed HTTPS on the server's addresses, space separated, e.g. "https://185.198.209.31 https://172.31.0.29"
# (set by the installer; the browser asks once to accept the certificate).
{$HTTPS_SITES:https://localhost} {
	tls internal
	import console
}
