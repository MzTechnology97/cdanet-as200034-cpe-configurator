#!/bin/sh
# Shortcut for the CDA Net stack: works from any directory, even though
# /opt/cdanet-cpe is readable by root only (it holds .env with the secrets).
#
#   sudo cdanet-cpe ps                      container status
#   sudo cdanet-cpe logs -f updater         auto-update history
#   sudo cdanet-cpe restart updater         check for a new version now
#   sudo cdanet-cpe up -d                   apply changes made to .env
#   sudo cdanet-cpe edit                    edit .env, then apply it
#   sudo cdanet-cpe backup                  database backup
#   sudo cdanet-cpe version                 running version
#   sudo cdanet-cpe geocoder [logs|reset]   local OpenStreetMap (Nominatim) status
#   sudo cdanet-cpe map [update|remove]     console maps (Protomaps basemap)
set -eu
DEPLOY_DIR="${DEPLOY_DIR:-/opt/cdanet-cpe}"
case "${1:-}" in ""|-h|--help|help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
[ "$(id -u)" -eq 0 ] || { echo "Usa: sudo cdanet-cpe $*" >&2; exit 1; }
dc() { docker compose -f "$DEPLOY_DIR/docker-compose.yml" --project-directory "$DEPLOY_DIR" "$@"; }
case "${1:-}" in
  edit)
    "${EDITOR:-nano}" "$DEPLOY_DIR/.env"
    dc up -d
    ;;
  backup)
    dc exec -T -u node app node src/cli/backup.ts manual
    ;;
  version)
    dc exec -T app wget -qO- http://127.0.0.1:8787/api/health; echo
    ;;
  geocoder)
    c=$(dc ps -q nominatim 2>/dev/null || true)
    if [ -z "$c" ]; then
      echo "OpenStreetMap locale non attivo. Per installarlo: sudo CDANET_GEOCODER=local ./deploy/install-debian.sh"
      exit 1
    fi
    case "${2:-status}" in
      logs) dc logs -f --tail=100 nominatim ;;
      reset)
        printf "Cancello i dati OpenStreetMap importati e rifaccio l'import da zero. Confermi? [s/N] "
        read -r a
        case "$a" in s|S|y|Y) ;; *) exit 1 ;; esac
        dc rm -sf nominatim
        docker volume rm cdanet-cpe-configurator_nominatim_data
        dc up -d nominatim
        echo "Import ripartito. Avanzamento: sudo cdanet-cpe geocoder logs"
        ;;
      *)
        docker inspect -f 'Container: {{.State.Status}} (salute: {{if .State.Health}}{{.State.Health.Status}}{{else}}n/d{{end}})' "$c"
        if docker exec "$c" curl -fsS 'http://127.0.0.1:8080/status?format=json' 2>/dev/null; then
          echo
        else
          echo "Import in corso o servizio non ancora pronto. Ultime righe del log:"
          dc logs --tail=15 nominatim
        fi
        ;;
    esac
    ;;
  map)
    case "${2:-status}" in
      update) dc --profile maps run --rm maptiles ;;
      remove)
        dc --profile maps run --rm --entrypoint rm maptiles -f /data/maps/basemap.pmtiles
        echo "Mappa rimossa: la console usa le mappe pubbliche di OpenStreetMap."
        ;;
      *)
        grep -E '^MAP_(MODE|REGION|BBOX)=' "$DEPLOY_DIR/.env" || echo "Mappe non configurate"
        dc exec -T app sh -c 'ls -lh /data/maps/basemap.pmtiles 2>/dev/null || echo "Mappa non ancora scaricata: sudo cdanet-cpe map update"'
        ;;
    esac
    ;;
  *)
    dc "$@"
    ;;
esac
