APP_DOMAIN=cpe.example.cdanet.it
APP_SCHEME=https
APP_LISTEN=:80
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ALLOWED_ORIGIN=https://cpe.example.cdanet.it
PROVISIONING_MODE=lab-apply
BRIDGE_URL=http://bridge.internal:9000
BRIDGE_TOKEN=replace-with-private-bridge-token
ANDROID_RELEASE_HOST_PATH=/srv/cdanet-private/releases
FIRMWARE_HOST_PATH=/srv/cdanet-private/firmware/WA-8.7.4.210415.b959c66ec28d1c26ce0eac9122cc345b1fe92450df74a6cf627f5cb28e83323c.bin
GDPR_AUDIT_RETENTION_DAYS=365
CPE_ADMIN_USERNAME=ubnt
CPE_ADMIN_PASSWORD=replace-at-deployment
UISP_ENROLLMENT=replace-at-deployment
SNMP_COMMUNITY=public
SNMP_CONTACT=172.31.0.7

NATIVE_ORIGIN=https://localhost

# RouterOS backend: default only private/CGNAT targets. Set 1 only on a protected NOC server when public router management is required.
ROUTEROS_ALLOW_PUBLIC=0


# Baseline CPE CDA Net derivata dal vecchio provisioning, modificabile senza cambiare codice.
CPE_LAN_IP=192.168.1.254
CPE_LAN_NETMASK=255.255.255.0
CPE_DHCP_START=192.168.1.10
CPE_DHCP_END=192.168.1.50
CPE_DHCP_LEASE=600
CPE_PPPOE_MTU=1450
CPE_PPPOE_MRU=1450
CPE_WATCHDOG_HOST=8.8.8.8
CPE_NTP_SERVER=10.0.0.254
CPE_SSH_PORT=22
CPE_DISCOVERY_PORT=10001

ANDROID_RELEASE_DIR=/opt/cdanet/releases
