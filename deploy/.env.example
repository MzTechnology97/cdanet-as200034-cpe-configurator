# CDA Net CPE Configurator - deployment settings (copied to .env by install-debian.sh).
# Never commit the real .env.
# Almost everything here can be changed from the console (Impostazioni server), without SSH:
# the console values take precedence; infrastructure keys are written here by the updater.

# --- Image / auto-update -----------------------------------------------------
# Image built by GitHub Actions from the repository. Channel "stable" = branch main.
CDANET_IMAGE=ghcr.io/mztechnology97/cdanet-cpe-server
CDANET_CHANNEL=stable
DEPLOY_DIR=/opt/cdanet-cpe
AUTOUPDATE=1
UPDATE_INTERVAL=300
# Optional maintenance window (local hours, start-end), e.g. 01-05. Empty = always.
UPDATE_WINDOW=

# --- Web / proxy -------------------------------------------------------------
# ":80" = plain HTTP on the LAN; a hostname (e.g. cpe.cda-net.it) enables automatic HTTPS.
APP_LISTEN=:80
# HTTPS with a certificate of Caddy's own CA (no public certificate), space separated;
# the installer fills it with the server's addresses. Browsers ask once to accept it.
#HTTPS_SITES=https://185.198.209.31 https://172.31.0.29
TRUST_PROXY=loopback,uniquelocal

# --- Security ----------------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_HOURS=8
ADMIN_USERNAME=admin
# The first admin password is asked by install-debian.sh and passed once, never stored here.
MASTER_KEY_HOST_PATH=/etc/cdanet-cpe/secrets/master.key
GDPR_AUDIT_RETENTION_DAYS=365

# --- CPE runtime secrets -------------------------------------------------------
CPE_ADMIN_USERNAME=ubnt
CPE_ADMIN_PASSWORD=replace-at-deployment
UISP_ENROLLMENT=
SNMP_COMMUNITY=public
SNMP_CONTACT=172.31.0.7

# --- CDA Net CPE baseline ------------------------------------------------------
CPE_FACTORY_IP=192.168.172.1
CPE_LAN_IP=192.168.1.254
CPE_LAN_NETMASK=255.255.255.0
CPE_DHCP_START=192.168.1.10
CPE_DHCP_END=192.168.1.50
CPE_DHCP_LEASE=600
CPE_PPPOE_MTU=1450
CPE_PPPOE_MRU=1450
CPE_WATCHDOG_HOST=8.8.8.8
CPE_NTP_SERVER=10.0.0.254
CPE_SSH_PORT=22
CPE_DISCOVERY_PORT=10001
PROVISION_JOB_TTL_MINUTES=30
# AP mostrati all'installatore per ogni verifica di copertura (web e app, 1-20)
INSTALLER_COVERAGE_APS=5
MIN_ANDROID_VERSION=1.0.0

# --- Android release channel ---------------------------------------------------
ANDROID_RELEASE_HOST_PATH=/srv/cdanet-private/releases
# Automatic download of the newest signed APK from the GitHub Releases of the repo.
ANDROID_RELEASE_GITHUB_REPO=MzTechnology97/cdanet-as200034-cpe-configurator
# Required only if the repository is private (fine-grained token, Contents: read-only).
ANDROID_RELEASE_GITHUB_TOKEN=
ANDROID_RELEASE_SYNC_MINUTES=30

# --- UISP integration (optional) ---------------------------------------------------
# Enables nearest-AP suggestions, 'Accetta in UISP' and CPE backups from the console.
# Token: UISP > Settings > Users > API tokens (read/write). Leave empty to disable.
UISP_API_URL=
UISP_API_TOKEN=
UISP_CACHE_SECONDS=60
UISP_AUTO_BACKUP=1
# 1 = accept a self-signed UISP certificate (only on a trusted management network).
# These values can also be set from the console: Connettori (they take precedence).
UISP_IGNORE_TLS=0
# Nearest APs are searched within this radius only (the full network map is never exposed).
COVERAGE_MAX_KM=15
# Public address of the console (links in Telegram notifications), e.g. https://cpe.cda-net.it
PUBLIC_URL=

# Address search for coverage (OpenStreetMap Nominatim).
# The installer sets these: local container (CDANET_GEOCODER=local) or public service.
#   local:  GEOCODER_URL=http://nominatim:8080, COMPOSE_PROFILES=geocoder, fallback = public service
#   public: max 1 request/s, only the searched address is sent
GEOCODER_MODE=
COMPOSE_PROFILES=
GEOCODER_URL=https://nominatim.openstreetmap.org

# Terrain elevation for the pointing tilt (SRTM tiles, AWS Open Data; cached in the data volume).
# Empty = off (no tilt).
#DEM_URL=https://elevation-tiles-prod.s3.amazonaws.com/skadi
GEOCODER_FALLBACK_URL=
# Local Nominatim (only with COMPOSE_PROFILES=geocoder). Region: isole, sud, centro, nord-est,
# nord-ovest, italia, sicilia, custom. Changing region requires: sudo cdanet-cpe geocoder reset
NOMINATIM_REGION=
NOMINATIM_PBF_URL=
NOMINATIM_REPLICATION_URL=
NOMINATIM_PASSWORD=
GEOCODER_CONTACT=

# --- RouterOS from the server ---------------------------------------------------
ROUTEROS_ALLOW_PUBLIC=0
