{
  "name": "cdanet-cpe-server",
  "private": true,
  "version": "1.2.0",
  "description": "CDA Net AS200034 CPE Configurator - control plane (API + Admin/NOC web)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
